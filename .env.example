# === 阿里百炼 DashScope API ===
# 获取方式：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=your-dashscope-api-key

# === ERP 账号（多租户时按 tenant_id 命名规则）===
# 租户 senlan_472 的 ERP 账号密码
ERP_472_USERNAME=472
ERP_472_PASSWORD=your-erp-password-for-472

# 添加新租户时：
# ERP_<TENANT_ID>_USERNAME=<username>
# ERP_<TENANT_ID>_PASSWORD=<password>

# === 飞书（可选，不填则跳过通知）===
# 简单模式：Webhook URL（仅支持纯文本消息）
FEISHU_WEBHOOK_URL=

# 完整模式：飞书自建应用 App ID/Secret（支持卡片消息、格式化通知）
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=your-app-secret
FEISHU_OPEN_ID=ou_xxxxx   # 默认接收用户 open_id

# === 可选：Checkpoint 数据库路径 ===
CHECKPOINTS_DB=checkpoints.db
